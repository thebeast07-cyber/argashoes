# Kosongkan untuk lokal: aplikasi otomatis pakai PGlite di ./.data/pglite
# Isi dengan connection string Neon untuk Preview/Production di Vercel.
DATABASE_URL=

# Opsional: lokasi folder PGlite (default ./.data/pglite)
PGLITE_DIR=

# Foto produk. Kosongkan untuk lokal: foto disimpan di ./.data/foto dan disajikan lewat /foto/[nama].
# Di Vercel wajib diisi (Storage → Blob → hubungkan ke project), karena filesystem Vercel hanya-baca.
BLOB_READ_WRITE_TOKEN=

# Sandi untuk membuat akun pemilik pertama lewat form login (hanya berlaku selama belum ada akun sama sekali).
# Isi di Vercel → Settings → Environment Variables. Jangan tulis nilainya di repo.
ADMIN_PASSWORD=

# Email ke pemilik setiap ada order baru (Resend, https://resend.com). Kosong = tidak mengirim email.
RESEND_API_KEY=
# Opsional. Default "Argashoes <onboarding@resend.dev>", yang hanya bisa mengirim ke email pemilik akun Resend.
# Untuk penerima lain, verifikasi domain di Resend lalu isi mis. "Argashoes <order@domainmu.com>".
EMAIL_PENGIRIM=
# Opsional. Penerima tambahan selain akun pemilik, dipisah koma.
EMAIL_NOTIFIKASI=
